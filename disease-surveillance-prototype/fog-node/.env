# Fog Node environment variables

# RabbitMQ connection string (uses Docker service name as host)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis connection string (uses Docker service name as host)
REDIS_URL=redis://redis:6379

# FastAPI bind settings
FOG_HOST=0.0.0.0
FOG_PORT=8000

# Blockchain RPC endpoint (Hardhat local node)
BLOCKCHAIN_RPC_URL=http://hardhat:8545
