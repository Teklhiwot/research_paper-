EXPO_PUBLIC_GATEWAY_URL=http://10.0.2.2:3000/report
# AES-256-GCM symmetric key – 64 hex chars (32 bytes). Shared with the gateway.
EXPO_PUBLIC_REPORT_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Ed25519 keypair is generated per-device and stored in AsyncStorage.
# No signing key env var is needed.