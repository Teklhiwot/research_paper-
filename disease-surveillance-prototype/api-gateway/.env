# API Gateway environment variables
# Copy this file to .env and fill in the values.

# AES-256-GCM symmetric key – must match EXPO_PUBLIC_REPORT_ENC_KEY on the edge client.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_DECRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RabbitMQ connection string
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT signing secret – used by authMiddleware to verify Bearer tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Replace this placeholder with a strong random secret before deployment.
JWT_SECRET=f6ebb6550f0a1a9571db447b61ceab7d04d4253dc4d4bfd263c36e8eb4161ccb

# HTTP port
PORT=3000
