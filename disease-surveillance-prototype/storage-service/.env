# Storage Service environment variables

# MongoDB connection string (uses Docker service name as host)
MONGODB_URI=mongodb://mongodb:27017/surveillance

# RabbitMQ connection string (uses Docker service name as host)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# HTTP port
PORT=4000

# AES-256-GCM encryption key for sensitive fields (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Must match the key used by api-gateway.
STORAGE_ENCRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT signing secret (used to verify tokens forwarded from api-gateway)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Replace this placeholder with a strong random secret before deployment.
JWT_SECRET=f6ebb6550f0a1a9571db447b61ceab7d04d4253dc4d4bfd263c36e8eb4161ccb
